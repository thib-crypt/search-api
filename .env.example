# ---- App ----
ENVIRONMENT=development
LOG_LEVEL=INFO
# json: one JSON object per log record, with the request id, the access line
# (method/path/status/duration_ms) and any exception traceback — what a log
# shipper wants. text: the plain one-liner, for a human tailing a local run.
LOG_FORMAT=json
# External port exposed by the API container (change if 8000 is already taken).
API_PORT=8000

# ---- Auth (on by default) ----
# /v1/research spends real money on your provider keys, so auth is required
# unless you explicitly turn it off. The app REFUSES TO START with
# AUTH_ENABLED=true and an empty API_KEYS.
AUTH_ENABLED=true
# Comma-separated list of accepted keys. Generate one with: openssl rand -hex 32
# Each entry is "label:key" or a bare "key" (which gets a stable derived label).
# Labels — never keys — are what logs, rate-limit buckets and cost counters use,
# so give each client its own: revoking one is then a one-line edit + restart.
#   API_KEYS=app-mobile:sk_a1b2...,script-perso:sk_c3d4...,test:sk_e5f6...
API_KEYS=

# ---- Hardening ----
RATE_LIMIT_ENABLED=true
# Points per 60s window per caller. Endpoints cost what they spend downstream:
# /v1/search 1, /v1/map 2, /v1/crawl 5, /v1/answer & /v1/extract 10,
# /v1/crawl/site 25, /v1/research 100, everything else 1. The bucket is keyed on
# the caller's API-key label when auth is on, on its IP otherwise.
RATE_LIMIT_RPM=120
# Optional per-label budgets, e.g. "app-mobile:500,test:20".
RATE_LIMIT_RPM_OVERRIDES=
# Max distinct clients tracked by the limiter (oldest evicted first).
RATE_LIMIT_MAX_CLIENTS=10000
# Set to true only when behind a trusted reverse-proxy that sets X-Forwarded-For.
TRUSTED_PROXY=false
SECURITY_HEADERS=true
# Comma-separated allowed CORS origins ("*" allows all).
CORS_ORIGINS=*

# ---- SearXNG ----
# Inside docker-compose use the service name; for local dev use http://localhost:8080
SEARXNG_URL=http://searxng:8080
SEARXNG_TIMEOUT=15
# Max pooled HTTP connections kept open to SearXNG.
SEARXNG_MAX_CONNECTIONS=64

# ---- Search cache ----
# Memoizes identical queries for a short window (big win for deep research).
SEARCH_CACHE_ENABLED=true
SEARCH_CACHE_TTL=300
SEARCH_CACHE_MAX_SIZE=512

# ---- Answer cache ----
# Reuses an identical /v1/answer response instead of re-running search+crawl+LLM.
# Key = query + model + max_sources + language. Streaming answers are not cached.
ANSWER_CACHE_ENABLED=true
ANSWER_CACHE_TTL=600
ANSWER_CACHE_MAX_SIZE=256

# ---- Jobs ----
# sqlite: jobs, results and progress events survive a container restart (needs
# the ./data volume in docker-compose.yml). memory: everything is lost on restart.
JOB_BACKEND=sqlite
JOB_DB_PATH=/srv/api/data/jobs.db
# How often the SQLite job database is VACUUMed (0 disables). Coarse on purpose:
# VACUUM rewrites the whole file.
JOB_VACUUM_INTERVAL_SECONDS=86400
# Seconds a finished job (and its result) is kept in memory before eviction.
JOB_RETENTION_SECONDS=3600
# How often the background sweeper drops aged-out jobs (0 disables it).
JOB_EVICT_INTERVAL_SECONDS=300
# Progress events retained per job (bounds the SSE replay of a 500-page crawl).
JOB_MAX_PROGRESS_EVENTS=500
# Max buffered events per SSE subscriber; a slow client loses the oldest.
JOB_SUBSCRIBER_QUEUE_SIZE=1000

# ---- LLM ----
# litellm provider strings: openai/..., anthropic/..., gemini/..., openrouter/...
LLM_MODEL=openai/gpt-4o-mini
# Optional dedicated model for report writing (falls back to LLM_MODEL).
LLM_REPORT_MODEL=
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=4096
# Max output tokens for the final research report (kept separate: LLM_MAX_TOKENS
# would cap a multi-page report at ~3000 words).
LLM_REPORT_MAX_TOKENS=8192
# Comma-separated models tried in order when the primary model keeps failing.
LLM_FALLBACK_MODELS=
# Max seconds for a single non-streaming LLM call.
LLM_TIMEOUT=120
# Max seconds a streaming LLM call may stall before it is retried.
LLM_STREAM_TIMEOUT=30
# Retries per model before the next fallback model is tried.
LLM_MAX_RETRIES=3
# Process-wide cap on in-flight LLM calls (not per request).
LLM_MAX_CONCURRENCY=10

# ---- Provider API keys (read directly by litellm; set only what you use) ----
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# ---- Crawl ----
# Hard cap on concurrent browser sessions, process-wide (not per request).
CRAWL_MAX_CONCURRENCY=5
CRAWL_TIMEOUT=30
# Minimum seconds between two hits on the SAME host (0 disables). Distinct hosts
# are never delayed.
CRAWL_PER_HOST_DELAY=1.0

# ---- Document ingestion ----
# Word, PowerPoint, Excel, OpenDocument, RTF, EPUB, CSV and PDF are converted to
# Markdown (tables included) before they would ever reach the browser. Setting
# this to false cuts the whole document path: those URLs go to Chromium, which
# will get nothing out of them.
CRAWL_ENABLE_DOCUMENTS=true
# Replaces CRAWL_PDF_MAX_MB, which still works as an alias for one version.
# Caps the DOWNLOAD. Decompression has its own limits, internal to the parser
# (a zip bomb inflating to 500 MB is handled without exhausting memory).
CRAWL_DOC_MAX_MB=25
# Fall back to pypdf when the converter fails on a PDF. Worth leaving on while
# the library is still 0.1.x: it keeps the previous extraction path reachable.
CRAWL_PDF_FALLBACK=true
# Max size of a file uploaded to POST /v1/convert. Bounds what reaches memory;
# bounding the transfer itself is your reverse proxy's job.
CONVERT_MAX_MB=25

# Deprecated aliases, honoured for one more version with a warning at startup.
# CRAWL_ENABLE_PDF=true      -> CRAWL_ENABLE_DOCUMENTS
# CRAWL_PDF_MAX_MB=25        -> CRAWL_DOC_MAX_MB

# ---- URL discovery (/v1/map) ----
# Max seconds per sitemap.xml / robots.txt fetch. Kept short on purpose: the
# endpoint exists to answer in about a second.
MAP_TIMEOUT=5

# ---- Crawl network guard (SSRF) ----
# Leave false in production: true lets any client make the server read
# 169.254.169.254, your SearXNG container, or anything else on the internal network.
CRAWL_ALLOW_PRIVATE_NETWORKS=false
# Ports the crawler may connect to (empty = any port).
CRAWL_ALLOWED_PORTS=80,443,8080
# Optional. If set, ONLY these domains (and their subdomains) may be crawled.
CRAWL_DOMAIN_ALLOWLIST=
# Optional. Domains (and subdomains) the crawler must never fetch.
CRAWL_DOMAIN_DENYLIST=

# ---- Research ----
RESEARCH_DEFAULT_BREADTH=4
RESEARCH_DEFAULT_DEPTH=2
RESEARCH_CONCURRENCY=2
# Max seconds for a synchronous /v1/research call (0 = no limit). Use background=true for long queries.
RESEARCH_SYNC_TIMEOUT=600
# Token budget for the learnings fed to the final report prompt.
RESEARCH_REPORT_TOKEN_BUDGET=12000
# SERP results asked per query (titles/snippets are free; only the top-k is crawled).
RESEARCH_RESULTS_PER_QUERY=10
# How many reranked results per SERP query are actually crawled.
RESEARCH_CRAWL_TOP_K=3
# Pre-crawl relevance filter: off | lexical | llm (llm falls back to lexical on failure).
RESEARCH_RERANK=llm
# Model used by the LLM reranker (empty = LLM_MODEL). Use a fast, cheap one.
RESEARCH_RERANK_MODEL=
# Seconds a rerank decision is reused across overlapping SERPs (0 disables).
RESEARCH_RERANK_CACHE_TTL=600
# Max tokens kept from a single crawled page.
RESEARCH_PER_PAGE_TOKEN_BUDGET=2000
# Total token budget for the page contents fed to one extraction call.
RESEARCH_PROCESS_CONTEXT_TOKEN_BUDGET=8000
# Max learnings / follow-up questions extracted per SERP query.
RESEARCH_NUM_LEARNINGS=3
RESEARCH_NUM_FOLLOWUPS=3

# ---- Cost circuit breakers ----
# Per-RUN ceiling. Once a research run passes this, it stops exploring and writes
# its report from what it already gathered — a shorter answer, not an error.
# 0 disables.
RESEARCH_MAX_COST_USD=0
# Per-KEY, per-UTC-day ceiling across /v1/research and /v1/answer. A key over
# budget gets a 429 while every other key keeps working. Durable only with
# JOB_BACKEND=sqlite; with JOB_BACKEND=memory the counter resets on restart.
# 0 disables.
DAILY_COST_CAP_USD=0
# Clients can price a run before committing: POST /v1/research {"estimate_only": true}

# ---- Webhooks (job-completion callbacks) ----
# HMAC-SHA256 key for the X-Webhook-Signature header. Generate with:
# openssl rand -hex 32. While empty, requests carrying a webhook_url are refused
# with a 400: an unsigned callback cannot be authenticated by its receiver.
WEBHOOK_SECRET=
# Max seconds for the callback POST. A failing webhook never fails the job.
WEBHOOK_TIMEOUT=10

# ---- MCP (Model Context Protocol) server ----
# Exposes the same capabilities as tools an AI agent can call, in THIS process:
# one browser pool, one search cache, one cost ledger, one job manager. A job an
# agent starts is a job you can inspect at GET /v1/jobs/{id}. See MCP_REFERENCE.md.
# Clients authenticate with the same API_KEYS, as `Authorization: Bearer <key>`.
MCP_ENABLED=true
MCP_PATH=/mcp
# Host values the MCP transport accepts (DNS-rebinding protection). In a container
# the request Host is the service name or your domain, never localhost — so an
# empty list here means "accept any Host" rather than refusing every request,
# which is right behind a reverse proxy that pins the Host itself. Set it
# explicitly (comma-separated, e.g. api.example.com) when the API is exposed
# directly to the internet.
MCP_ALLOWED_HOSTS=
# Token ceiling on ONE tool result. This is agent context, not bandwidth: whatever
# a tool returns is re-sent on every following turn of the conversation, so an
# unbounded crawl result costs more than the conversation that asked for it.
# Anything cut is marked in place and stays readable as a search-api:// resource.
MCP_MAX_RESULT_TOKENS=4000
# Max URLs in one fetch_url call. Lower than the HTTP cap of 50 on purpose: the
# HTTP limit bounds the server's work, this one bounds an agent loop's.
MCP_MAX_URLS_PER_CALL=10
# How long a truncated result stays fetchable, and how many are kept. In memory,
# not on disk: an artefact is expensive to transport, not to recompute.
MCP_ARTIFACT_TTL=1800
MCP_ARTIFACT_MAX_ITEMS=256
# off | resource | inline. Screenshots and PDF renders are base64, i.e. tens of
# thousands of tokens the agent pays for on every turn — never inlined by default.
# 'resource' returns a link the client may load; 'inline' embeds the image.
MCP_IMAGE_MODE=off
# Simultaneous deep_research runs per API key. DAILY_COST_CAP_USD is a finish-line
# limit; this one stops an agent loop from reaching it in thirty seconds.
MCP_RESEARCH_MAX_CONCURRENT=2

# ---- Observability ----
# GET /metrics exposes the Prometheus exposition (request latency and error rate
# per route, cache hit ratios, crawl outcomes, active jobs and browser sessions,
# LLM tokens and cost per API-key label). It needs an API key like every other
# endpoint — it publishes what each of your clients spends — and it is exempt
# from rate limiting so a scrape never eats a caller's budget.
#
# OpenTelemetry tracing of FastAPI + httpx (search -> crawl -> LLM). Off by
# default; the exporter reads the OTel SDK's own environment variables, so there
# is no second name for the collector endpoint.
OTEL_ENABLED=false
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
# OTEL_SERVICE_NAME=unified-search-api

# ---- SearXNG container secret (generate with: openssl rand -hex 32) ----
SEARXNG_SECRET=change-me-please
